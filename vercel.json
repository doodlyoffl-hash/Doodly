{
  "redirects": [
    { "source": "/next-app/:path*", "destination": "/", "permanent": false },
    { "source": "/docs/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/check-delivery", "destination": "/check-delivery.html" },
    { "source": "/delivery-availability", "destination": "/check-delivery.html" },
    { "source": "/rewards/claim", "destination": "/rewards/claim.html" }
  ],
  "headers": [
    {
      "source": "/assets/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
